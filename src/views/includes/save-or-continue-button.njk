{% if (IS_POST_TRANSITION_NOT_ADD(journeyTypes, serviceName, i18n)) %}
  {{ govukButton({
    text: i18n.buttons.continue,
    attributes: {
      "id": "submit",
      "data-event-id": "continue"
    }
  }) }}
{% else %}
  {{ govukButton({
    text: i18n.buttons.saveAndContinue,
    attributes: {
      "id": "submit",
      "data-event-id": "save-and-continue"
    }
  }) }}
{% endif %}




