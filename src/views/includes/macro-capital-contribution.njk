{% macro formatCapitalContribution(item, i18n) %}
  <p class="govuk-body">
    {{ item.data.contribution_currency_value }} {{ i18n.currencies[item.data.contribution_currency_type] }}
  </p>
  <p class="govuk-body">
    {{ buildFormattedListFromArray(item.data.contribution_sub_types, i18n) }}
  </p>
{% endmacro %}

{%- macro buildFormattedListFromArray(array, i18n) -%}
  {% set capitalContributionSubTypesMap = {
    "MONEY": i18n.partner.capitalContribution.money,
    "LAND_OR_PROPERTY": i18n.partner.capitalContribution.landOrProperty,
    "SHARES": i18n.partner.capitalContribution.shares,
    "SERVICES_OR_GOODS": i18n.partner.capitalContribution.servicesOrGoods,
    "ANY_OTHER_ASSET": i18n.partner.capitalContribution.anyOtherAsset
    } 
  %}

  {%- set returnValue = [] -%}
    {%- for item in array -%}
      {%- set returnValue = returnValue.concat(capitalContributionSubTypesMap[item]) -%}
    {%- endfor -%}
  {{- returnValue.join(' / ') -}}
{%- endmacro -%}