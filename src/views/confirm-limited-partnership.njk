{% extends "layout.njk" %}

{% set pageTitle = i18n.partnership.confirmLimitedPartnership.title %}

{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% import 'includes/macros.njk' as macros %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds-from-desktop">
      {% include "includes/errors.njk" %}

      <form class="form" method="post">
        <input type="hidden" name="pageType" value={{ props.pageType }}> 
        {% include "includes/csrf_token.njk" %}

        <h1 class="govuk-heading-xl">{{ pageTitle }}</h1>

        {{ govukSummaryList({
            classes: "govuk-!-margin-bottom-9",
            rows: [
              {
                key: {
                  text: i18n.partnership.confirmLimitedPartnership.partnershipName
                },
                value: {
                  text: props.data.limitedPartnership.data.partnership_name
                }
              },
              {
                key: {
                  text: i18n.partnership.confirmLimitedPartnership.partnershipNumber
                },
                value: {
                  text: props.data.limitedPartnership.data.partnership_number
                }
              },
              {
                key: {
                  text: i18n.partnership.confirmLimitedPartnership.status
                },
                value: {
                  text: i18n.companyStatus[props.data.limitedPartnership.data.company_status] or props.data.limitedPartnership.data.company_status
                }
              },
              SET_REGISTRATION_DATE_SECTION(props.data.limitedPartnership, i18n),
              {
                key: {
                  text: i18n.partnership.confirmLimitedPartnership.principalPlaceOfBusiness
                },
                value: {
                  html: macros.formatAddressMultiLine(props.data.limitedPartnership.data.principal_place_of_business_address, true, i18n)
                }
              }
            ]
        }) }}

        {% include "includes/continue-button.njk" %}

        <p class="govuk-body">
          <a href="{{ props.previousUrl }}" class="govuk-link" data-event-id="choose-different-partnership-link">{{ i18n.partnership.confirmLimitedPartnership.chooseDifferentPartnership }}</a>
        </p>
      </form>
    </div>
  </div>
{% endblock %}