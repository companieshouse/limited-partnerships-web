{% if item.data.forename %}
  {% set nationalities = macros.formatNationality(item.data.nationality1, i18n) %}
  {% if item.data.nationality2 %}
    {% set nationalities = macros.formatNationality(item.data.nationality1, i18n) + ", " + macros.formatNationality(item.data.nationality2, i18n) %}
  {% endif %}

  {{ govukSummaryList({
    classes: "govuk-!-margin-bottom-7",
    rows: [
      {
        key: {
          text: i18n.checkYourAnswersPage.partners.person.name
        },
        value: {
          text: item.data.forename + " " + item.data.surname
        },
        actions: {
          items: [
            CREATE_CHANGE_LINK(
              i18n.checkYourAnswersPage.change,
              ((props.currentUrl + "#forename") | replace(props.pageType, "add-general-partner-person")),
              i18n.checkYourAnswersPage.partners.person.name,
              "change-name-button"
            )
          ]
        } if journeyTypes.isPostTransition
      },
      {
        key: {
          text: i18n.checkYourAnswersPage.partners.person.formerNames
        },
        value: {
          text: item.data.former_names
        },
        actions: {
          items: [
            CREATE_CHANGE_LINK(
              i18n.checkYourAnswersPage.change,
              ((props.currentUrl + "#former_names") | replace(props.pageType, "add-general-partner-person")),
              i18n.checkYourAnswersPage.partners.person.formerNames,
              "change-former-names-button"
            )
          ]
        } if journeyTypes.isPostTransition
      } if item.data.former_names,
      
      SET_DATE_OF_BIRTH_SECTION(item, i18n, journeyTypes, props),
      
      {
        key: {
          text: i18n.checkYourAnswersPage.partners.person.nationality
        },
        value: {
          text: nationalities
        },
        actions: {
          items: [
            CREATE_CHANGE_LINK(
              i18n.checkYourAnswersPage.change,
              ((props.currentUrl + "#nationality1") | replace(props.pageType, "add-general-partner-person")),
              i18n.checkYourAnswersPage.partners.person.nationality,
              "change-nationality-button"
            )
          ]
        } if journeyTypes.isPostTransition
      },
      {
        key: {
          text: i18n.checkYourAnswersPage.partners.person.usualResidentialAddress
        },
        value: {
          text: macros.formatAddress(item.data.usual_residential_address, true, i18n)
        },
        actions: {
          items: [
            CREATE_CHANGE_LINK(
              i18n.checkYourAnswersPage.change,
              ((props.currentUrl) | replace(props.pageType, "enter-general-partner-usual-residential-address")),
              i18n.checkYourAnswersPage.partners.person.usualResidentialAddress,
              "change-usual-residential-address-button"
            )
          ]
        } if journeyTypes.isPostTransition
      },
      {
        key: {
          text: i18n.checkYourAnswersPage.partners.person.correspondenceAddress
        },
        value: {
          text: macros.formatAddress(item.data.service_address, true, i18n)
        },
        actions: {
          items: [
            CREATE_CHANGE_LINK(
              i18n.checkYourAnswersPage.change,
              ((props.currentUrl) | replace(props.pageType, "enter-general-partner-correspondence-address")),
              i18n.checkYourAnswersPage.partners.person.correspondenceAddress,
              "change-correspondence-address-button"
            )
          ]
        } if journeyTypes.isPostTransition
      },

      SET_DATE_EFFECTIVE_FROM_SECTION(item, "generalPartner", journeyTypes, i18n, props)
    ]
  }) }}
